# Base URL of this repo's own backend (./backend — see its
# .env.example), including the /api/v1 prefix. Locally that's your
# backend's PORT (default 8080); in production it's whatever URL
# Render assigns the uvactive-branch-portal-backend service in
# render.yaml.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Identity Services Web client ID — same value you set as
# GOOGLE_STAFF_CLIENT_ID in ./backend/.env. Leave blank to hide the
# "Sign in with Google" button (password + TOTP still works fully).
VITE_GOOGLE_STAFF_CLIENT_ID=
