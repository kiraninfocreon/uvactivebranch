# Branch Portal talks ONLY to its own co-located backend (./backend,
# SERVICE_SCOPE=branch by default — see backend/src/config/configuration.ts).
# It cannot reach /admin/* or /trainer/* or /member/* routes at all on
# this URL; the service itself 404s those, not just this app choosing
# not to call them.
# Local dev: run `npm run start:dev` inside ./backend (default port 8080),
# then point this at it.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Identity Services Web client ID — same value you set as
# GOOGLE_STAFF_CLIENT_ID in ./backend/.env. Leave blank to hide the
# "Sign in with Google" button (password + TOTP still works fully).
VITE_GOOGLE_STAFF_CLIENT_ID=
