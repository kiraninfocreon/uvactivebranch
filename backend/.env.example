# Branch Portal backend — forked from uvactive-cloud-api, kept for this
# app only. Connects directly to the SAME Postgres database as the
# Admin Panel backend and uvactive-cloud-api (trainer/member app
# backend) — do not point this at a different database.
#
# SERVICE_SCOPE defaults to "branch" here (unlike the shared repo this
# was forked from, which defaulted to "all"), so a plain `npm run
# start:dev` with no SERVICE_SCOPE set already gates this deployment
# down to /branch/* and /auth/staff/* only, matching what the Branch
# Portal frontend actually calls. Leave it as "branch" in every real
# deployment; only override to "all" for local testing against routes
# outside this app's own scope.
NODE_ENV=development
PORT=8080
SERVICE_SCOPE=branch

DATABASE_URL=postgresql://uvactive:uvactive_dev_only@localhost:5432/uvactive
# On Vercel specifically: every cold start of the serverless function
# opens a fresh Prisma connection pool against this URL. If you're on
# Neon, use the pooled connection string (the host with "-pooler" in
# it, from Neon's dashboard), not the direct one — a handful of
# concurrent cold starts against the direct connection can exhaust
# Postgres's max_connections fast. If your provider doesn't offer a
# built-in pooler, add ?pgbouncer=true&connection_limit=1 to this URL
# instead. This only matters for the Vercel deployment — Render's
# persistent process doesn't have this problem.
REDIS_URL=

# Must be identical to the value used by the Admin Panel backend and
# uvactive-cloud-api — all three verify tokens against the same three
# secrets. Trainer App staff logins (via uvactive-cloud-api) and
# Branch Portal staff logins (via this backend) both issue/verify
# staff tokens against JWT_STAFF_SECRET, so it has to match exactly.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_MEMBER_SECRET=
JWT_STAFF_SECRET=
JWT_ADMIN_SECRET=
ACCESS_TOKEN_TTL_MEMBER_MIN=60
ACCESS_TOKEN_TTL_STAFF_MIN=15
ACCESS_TOKEN_TTL_ADMIN_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

TOTP_ISSUER=UVActive

# Google Identity Services Web client ID — same value as
# VITE_GOOGLE_STAFF_CLIENT_ID in this repo's frontend .env. Leave
# blank to hide the "Sign in with Google" button.
GOOGLE_STAFF_CLIENT_ID=

EXPO_PUSH_ACCESS_TOKEN=
SMS_PROVIDER_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=UV Active <onboarding@resend.dev>
EMAIL_LOGO_URL=https://iili.io/CSYLcnn.jpg

S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=

# Lock this down to the deployed Branch Portal frontend origin in
# production, e.g. https://uvactive-branch-portal.onrender.com
CORS_ORIGINS=http://localhost:5174
